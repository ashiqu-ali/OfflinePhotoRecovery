<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What macOS lets this app do. There is deliberately NO com.apple.security.network.client or
  network.server key, so the App Sandbox refuses every network connection (internet and local
  network alike), and the libimobiledevice helpers inherit the same sandbox.

  The single exception lets the app talk to /private/var/run/usbmuxd, macOS's own local service
  for iPhones connected by USB cable. That is a file on this Mac, not a network address.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Lets the app remember the backup location you chose (for example an external drive). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.temporary-exception.sbpl</key>
	<array>
		<string>(allow network-outbound (literal "/private/var/run/usbmuxd"))</string>
	</array>
</dict>
</plist>
